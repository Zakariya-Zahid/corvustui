{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."],
      "cwd": ".",
      "inherit_env": false,
      "timeout": 60
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "cwd": ".",
      "inherit_env": false,
      "timeout": 60
    }
  }
}
