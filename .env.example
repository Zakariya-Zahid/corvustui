# CorvusTUI Configuration
# Copy to .env and fill in your values

# Logging
CORVUS_LOG_LEVEL=INFO

# Default provider (ollama, openai, anthropic, groq, gemini, openrouter, grok)
CORVUS_DEFAULT_PROVIDER=ollama
# For Ollama this model must be installed (`ollama pull <model>`). If it is
# missing and no --model is given, the CLI uses the only installed model or
# prompts, and the TUI starts with the first installed model.
CORVUS_DEFAULT_MODEL=qwen3.5:0.8b

# Provider-specific defaults used when --model is omitted
CORVUS_OPENAI_DEFAULT_MODEL=gpt-4o-mini
CORVUS_ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
CORVUS_GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
CORVUS_GEMINI_DEFAULT_MODEL=gemini-1.5-flash
CORVUS_OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
CORVUS_GROK_DEFAULT_MODEL=grok-2-latest

# Ollama (local)
CORVUS_OLLAMA_BASE_URL=http://localhost:11434
CORVUS_OLLAMA_TIMEOUT=120

# OpenAI
CORVUS_OPENAI_API_KEY=
CORVUS_OPENAI_BASE_URL=https://api.openai.com/v1
CORVUS_OPENAI_ORGANIZATION=

# Anthropic
CORVUS_ANTHROPIC_API_KEY=
CORVUS_ANTHROPIC_BASE_URL=https://api.anthropic.com
CORVUS_ANTHROPIC_VERSION=2023-06-01

# Groq
CORVUS_GROQ_API_KEY=
CORVUS_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
CORVUS_GEMINI_API_KEY=
CORVUS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter
CORVUS_OPENROUTER_API_KEY=
CORVUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Grok (xAI)
CORVUS_GROK_API_KEY=
CORVUS_GROK_BASE_URL=https://api.x.ai/v1

# Context Management
CORVUS_MAX_CONTEXT_TOKENS=8192
CORVUS_RESERVED_TOKENS=1024
CORVUS_SUMMARIZATION_THRESHOLD=0.8
CORVUS_SUMMARIZATION_MODEL=qwen3.5:0.8b

# ReAct Loop
CORVUS_MAX_ITERATIONS=10
CORVUS_MAX_TOOL_RETRIES=3
CORVUS_TOOL_TIMEOUT=60

# MCP (built-in client; no extra dependency)
CORVUS_MCP_ENABLED=true
# CORVUS_MCP_SERVERS_CONFIG=~/.config/corvustui/mcp.json
CORVUS_MCP_TIMEOUT=30

# Safety guardrails
CORVUS_SAFETY_ENABLED=true
# Additional roots the agent may read/write (JSON list). The current working
# directory is always included.
# CORVUS_SAFETY_ALLOWED_PATHS=["/home/you/projects"]
CORVUS_SAFETY_ALLOW_OUTSIDE_PATHS=false
CORVUS_SAFETY_DENY_SENSITIVE_PATHS=true
# deny_dangerous | allowlist | unrestricted
CORVUS_SAFETY_SHELL_MODE=deny_dangerous
# CORVUS_SAFETY_SHELL_ALLOWLIST=["ls","cat","git","pytest"]
# CORVUS_SAFETY_SHELL_DENYLIST=[]
CORVUS_SAFETY_NETWORK_ENABLED=true
CORVUS_SAFETY_REQUIRE_APPROVAL=true
# Extra tool names that always require approval (JSON list).
# CORVUS_SAFETY_APPROVAL_TOOLS=[]
CORVUS_SAFETY_AUTO_APPROVE=false
CORVUS_SAFETY_REDACT_SECRETS=true
# CORVUS_SAFETY_AUDIT_PATH=~/.corvustui/audit.jsonl
CORVUS_SAFETY_AUDIT_PREVIEW_CHARS=2000

# RAG / Memory (optional)
# CORVUS_CHROMADB_PATH=
# CORVUS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# CORVUS_RAG_TOP_K=5
# CORVUS_RAG_SIMILARITY_THRESHOLD=0.7

# Tavily Web Search (optional)
# CORVUS_TAVILY_API_KEY=